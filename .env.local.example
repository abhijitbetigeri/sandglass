# Copy to .env.local and fill in. .env.local is git-ignored — never commit it.

# Tenki: the edge fleet (microVMs). https://tenki.cloud → API keys. Starts with "tk_".
# The SDK resolves: explicit arg → TENKI_AUTH_TOKEN → TENKI_API_KEY
TENKI_API_KEY=

# Wasmer: NOT needed to run sandboxes locally — that part is free.
# Only for publishing to the registry and deploying to Wasmer Edge.
# Easiest: `wasmer login`. Otherwise https://wasmer.io/settings/access-tokens
WASMER_TOKEN=

# AgentMail — PLANNED, not yet wired. Audit + command transport over
# intermittent links (store-and-forward suits a device that is offline most
# of the time). Free signup at https://agentmail.to
AGENTMAIL_API_KEY=

# Optional: the LLM driving the agent inside the sandbox.
ANTHROPIC_API_KEY=
